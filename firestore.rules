rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownNew() {
      return signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    function ownExisting() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    // User profile: private to the account owner.
    match /skillup_profiles/{uid} {
      allow get, create, update: if signedIn() && uid == request.auth.uid;
      allow delete: if signedIn() && uid == request.auth.uid;
      allow list: if false;
    }

    // Learning/progress records: private to the account owner.
    match /skillup_progress/{docId} {
      allow get: if ownExisting();
      allow list: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if ownNew();
      allow update: if ownExisting() &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if ownExisting();
    }

    // Community posts are readable by authenticated learners.
    // Only the author can edit/delete their own post.
    match /skillup_posts/{postId} {
      allow read: if signedIn();
      allow create: if ownNew() &&
        request.resource.data.keys().hasAll(['user_id', 'text', 'type', 'created_at']);
      allow update: if signedIn() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.created_at == resource.data.created_at;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid &&
          request.resource.data.user_id == request.auth.uid;
        allow delete: if signedIn() && uid == request.auth.uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.user_id == request.auth.uid &&
          request.resource.data.text is string;
        allow update: if signedIn() && resource.data.user_id == request.auth.uid &&
          request.resource.data.user_id == resource.data.user_id;
        allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
      }

      match /saves/{uid} {
        allow read: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid &&
          request.resource.data.user_id == request.auth.uid;
        allow delete: if signedIn() && uid == request.auth.uid;
        allow update: if false;
      }
    }

    // Notifications can only be read/marked read by their recipient.
    // Creation is restricted to a user acting on a post owned by the recipient.
    match /skillup_notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.actor_id == request.auth.uid &&
        request.resource.data.user_id != request.auth.uid &&
        exists(/databases/$(database)/documents/skillup_posts/$(request.resource.data.post_id)) &&
        get(/databases/$(database)/documents/skillup_posts/$(request.resource.data.post_id)).data.user_id == request.resource.data.user_id;
      allow update: if signedIn() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.actor_id == resource.data.actor_id &&
        request.resource.data.post_id == resource.data.post_id;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Reports may be submitted by signed-in users.
    // Reports are not readable from the client.
    match /skillup_reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reported_by == request.auth.uid &&
        request.resource.data.post_id is string;
      allow read, update, delete: if false;
    }

    // Learning communities.
    match /skillup_communities/{communityId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.owner_id == request.auth.uid &&
        request.resource.data.member_count == 1;

      // Owner can edit/delete. A normal member can only perform the
      // atomic +1 member-count update that accompanies their first join.
      allow update: if signedIn() && (
        (
          resource.data.owner_id == request.auth.uid &&
          request.resource.data.owner_id == resource.data.owner_id
        ) ||
        (
          request.resource.data.owner_id == resource.data.owner_id &&
          request.resource.data.member_count == resource.data.member_count + 1 &&
          !exists(/databases/$(database)/documents/skillup_communities/$(communityId)/members/$(request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/skillup_communities/$(communityId)/members/$(request.auth.uid)).data.user_id == request.auth.uid &&
          getAfter(/databases/$(database)/documents/skillup_communities/$(communityId)/members/$(request.auth.uid)).data.role == 'member'
        )
      );

      allow delete: if signedIn() && resource.data.owner_id == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid &&
          request.resource.data.user_id == request.auth.uid &&
          (
            request.resource.data.role == 'member' ||
            (
              request.resource.data.role == 'owner' &&
              get(/databases/$(database)/documents/skillup_communities/$(communityId)).data.owner_id == request.auth.uid
            )
          );
        allow update: if signedIn() && uid == request.auth.uid &&
          request.resource.data.user_id == resource.data.user_id &&
          request.resource.data.role == resource.data.role;
        allow delete: if signedIn() && uid == request.auth.uid;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
